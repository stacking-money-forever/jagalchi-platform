{
  "name": "@jagalchi/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-prod-env.mjs && pnpm --filter @jagalchi/api-client build",
    "build": "next build",
    "build:prod": "node scripts/verify-prod-env.mjs --production && next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:consumer-contracts": "node scripts/check-consumer-contracts.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --config vitest.unit.config.ts",
    "test:run": "vitest run --config vitest.unit.config.ts",
    "test:storybook": "vitest run --project storybook",
    "test:all": "vitest run",
    "figma:sync": "tsx scripts/sync-figma-components.ts",
    "figma:export": "tsx scripts/figma-export.ts",
    "figma:screenshots": "tsx scripts/storybook-screenshots.ts",
    "figma:compare": "tsx scripts/compare-images.ts",
    "figma:report": "tsx scripts/generate-report.ts",
    "figma:snapshot": "tsx scripts/figma-snapshot.ts",
    "figma:test": "pnpm figma:export && pnpm figma:screenshots && pnpm figma:compare && pnpm figma:report",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
