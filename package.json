{
  "name": "jagalchi-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.3 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @jagalchi/web dev",
    "dev:v1": "bash scripts/dev-v1.sh",
    "test:v1-local": "bash scripts/test-v1-local-e2e.sh",
    "check:v1-harness": "bash scripts/check-v1-harness.sh",
    "lint": "pnpm --filter @jagalchi/api-client lint && pnpm --filter @jagalchi/web lint",
    "test": "pnpm --filter @jagalchi/api-client test && pnpm --filter @jagalchi/web test:run && pnpm --filter @jagalchi/mobile test",
    "typecheck": "pnpm --filter @jagalchi/api-client typecheck && pnpm --filter @jagalchi/api-client typecheck:consumers && pnpm --filter @jagalchi/web typecheck && pnpm --filter @jagalchi/mobile typecheck",
    "build": "pnpm --filter @jagalchi/api-client build && pnpm --filter @jagalchi/web build",
    "verify": "pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "postinstall": "pnpm --filter @jagalchi/api-client build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ],
    "overrides": {
      "rollup": "4.59.0",
      "webpack": "5.104.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "serialize-javascript@<=7.0.2": "7.0.3",
      "webpack@>=5.49.0 <=5.104.0": "5.104.1",
      "ajv@<6.14.0": "6.14.0",
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "handlebars@>=4.0.0 <=4.7.8": ">=4.7.9",
      "brace-expansion@<1.1.13": "^1.1.13",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "next@>=16.0.0-beta.0 <16.2.3": ">=16.2.3",
      "dompurify@<=3.3.3": ">=3.4.0"
    }
  }
}
